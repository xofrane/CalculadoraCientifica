<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRAFICADOR DE FUNCIONES"
            android:textColor="@color/text_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp"/>

        <!-- Selección de Origen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccionar origen:"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnModoManual"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="Manual"/>

            <Button
                android:id="@+id/btnModoHistorial"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="Historial"/>

            <Button
                android:id="@+id/btnModoActual"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="Actual"/>
        </LinearLayout>

        <!-- Campo de entrada de función -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Función o valor:"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etFuncionInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/bg_display"
            android:hint="Ej. x*x o sin(x) o 5"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_expression"
            android:textColorHint="#888888"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <!-- Controles de los ejes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eje X mín:"
                android:textColor="@color/text_title"
                android:textSize="13sp"
                android:paddingEnd="4dp"/>

            <EditText
                android:id="@+id/etXMin"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@color/bg_display"
                android:gravity="center"
                android:hint="-10"
                android:inputType="numberSigned|numberDecimal"
                android:textColor="@color/text_expression"
                android:textColorHint="#888888"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" máx:"
                android:textColor="@color/text_title"
                android:textSize="13sp"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"/>

            <EditText
                android:id="@+id/etXMax"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@color/bg_display"
                android:gravity="center"
                android:hint="10"
                android:inputType="numberSigned|numberDecimal"
                android:textColor="@color/text_expression"
                android:textColorHint="#888888"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Botones de Acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnGenerarGrafica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GRAFICAR"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnLimpiarGrafica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LIMPIAR"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Información sobre la gráfica -->
        <TextView
            android:id="@+id/tvInfoGrafica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_result"
            android:textSize="13sp"
            android:textStyle="italic"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <!-- Gráfica MPAndroidChart -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartGrafica"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@color/bg_display"/>

    </LinearLayout>
</ScrollView>